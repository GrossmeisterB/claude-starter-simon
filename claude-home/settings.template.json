{
  "env": { "IMPECCABLE_NO_TELEMETRY": "1", "DO_NOT_TRACK": "1" },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"Heutiges Datum: %s (frisch via date +%%F). Dieses Datum verwenden.\"}}' \"$(date +%F)\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|Bash",
        "hooks": [
          { "type": "command", "command": "node \"$HOME/.claude/hooks/block-sensitive.mjs\"" }
        ]
      },
      {
        "matcher": "Grep|Glob",
        "hooks": [
          { "type": "command", "command": "node \"$HOME/.claude/hooks/block-sensitive.mjs\"" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$HOME/.claude/hooks/daily-note.mjs\"" }
        ]
      }
    ]
  }
}
