---
import Base from "../layouts/Base.astro";
import site from "../content/site.json";

const k = site.kontakt;
---

<Base>
  <section class="hero">
    <div class="wrap">
      <p class="art">{site.art} in {k.ort}</p>
      <h1>{site.name}</h1>
      <p class="slogan">{site.slogan}</p>
      <div class="aktionen">
        <a class="btn" href={`tel:${k.telefon.replace(/\s/g, "")}`}>Tisch reservieren</a>
        <a class="btn sekundaer" href="#speisekarte">Speisekarte</a>
      </div>
    </div>
  </section>

  {site.hinweis && (
    <div class="hinweis" role="status">
      <div class="wrap">{site.hinweis}</div>
    </div>
  )}

  <section class="ueber">
    <div class="wrap">
      <h2>Willkommen</h2>
      <p>{site.beschreibung}</p>
    </div>
  </section>

  <section id="speisekarte" class="karte">
    <div class="wrap">
      <h2>Speisekarte</h2>
      {site.speisekarte.map((gruppe) => (
        <div class="gruppe">
          <h3>{gruppe.titel}</h3>
          <ul>
            {gruppe.gerichte.map((g) => (
              <li>
                <div class="zeile">
                  <span class="name">{g.name}{g.vegi && <span class="vegi" title="vegetarisch"> · vegi</span>}</span>
                  <span class="preis">CHF {g.preis}</span>
                </div>
                {g.beschreibung && <p class="beschr">{g.beschreibung}</p>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section id="zeiten" class="zeiten">
    <div class="wrap">
      <h2>Öffnungszeiten</h2>
      <dl>
        {site.oeffnungszeiten.map((o) => (
          <div class="tag">
            <dt>{o.tage}</dt>
            <dd>{o.zeit.split(", ").map((z) => <span class="block">{z}</span>)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="kontakt" class="kontakt">
    <div class="wrap">
      <h2>Kontakt &amp; Anfahrt</h2>
      <address>
        {site.name}<br />
        {k.strasse}<br />
        {k.plz} {k.ort}
      </address>
      <p>
        <a href={`tel:${k.telefon.replace(/\s/g, "")}`}>{k.telefon}</a><br />
        <a href={`mailto:${k.email}`}>{k.email}</a>
      </p>
      <a class="btn sekundaer" href={k.maps_url} rel="noopener" target="_blank">Route planen</a>
    </div>
  </section>
</Base>

<style>
  ul { list-style: none; padding: 0; }
  .zeile { display: flex; justify-content: space-between; gap: 1rem; }
</style>
