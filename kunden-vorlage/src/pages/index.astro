---
import Base from "../layouts/Base.astro";
import site from "../content/site.json";

const k = site.kontakt;
---

<Base>
  <section class="hero">
    <div class="wrap">
      <p class="art">{site.art} in {k.ort}</p>
      <h1>{site.name}</h1>
      <p class="slogan">{site.slogan}</p>
      <div class="aktionen">
        <a class="btn" href={`tel:${k.telefon.replace(/\s/g, "")}`}>Tisch reservieren</a>
        <a class="btn sekundaer" href="#speisekarte">Speisekarte</a>
      </div>
    </div>
  </section>

  {site.hinweis && (
    <div class="hinweis" role="status">
      <div class="wrap">{site.hinweis}</div>
    </div>
  )}

  <section class="ueber">
    <div class="wrap">
      <h2>Willkommen</h2>
      <p>{site.beschreibung}</p>
    </div>
  </section>

  <section id="speisekarte" class="karte">
    <div class="wrap">
      <h2>Speisekarte</h2>
      {site.speisekarte.map((gruppe) => (
        <div class="gruppe">
          <h3>{gruppe.titel}</h3>
          <ul>
            {gruppe.gerichte.map((g) => (
              <li>
                <div class="zeile">
                  <span class="name">{g.name}{g.vegi && <span class="vegi" title="vegetarisch"> · vegi</span>}</span>
                  <span class="preis">CHF {g.preis}</span>
                </div>
                {g.beschreibung && <p class="beschr">{g.beschreibung}</p>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section id="zeiten" class="zeiten">
    <div class="wrap">
      <h2>Öffnungszeiten</h2>
      <dl>
        {site.oeffnungszeiten.map((o) => (
          <div class="tag">
            <dt>{o.tage}</dt>
            <dd>{o.zeit.split(", ").map((z) => <span class="block">{z}</span>)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="kontakt" class="kontakt">
    <div class="wrap">
      <h2>Kontakt &amp; Anfahrt</h2>
      <address>
        {site.name}<br />
        {k.strasse}<br />
        {k.plz} {k.ort}
      </address>
      <p>
        <a href={`tel:${k.telefon.replace(/\s/g, "")}`}>{k.telefon}</a><br />
        <a href={`mailto:${k.email}`}>{k.email}</a>
      </p>
      <a class="btn sekundaer" href={k.maps_url} rel="noopener" target="_blank">Route planen</a>
    </div>
  </section>
</Base>

<style>
  .hero { background: linear-gradient(160deg, var(--primaer), color-mix(in srgb, var(--primaer) 70%, black)); color: #fff; padding-block: 4rem 3.5rem; }
  .hero h1 { font-size: clamp(2.2rem, 8vw, 3.6rem); }
  .art { text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.85rem; color: var(--akzent); margin: 0 0 0.5rem; }
  .slogan { font-size: 1.2rem; max-width: 34rem; }
  .aktionen { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .hero .btn { background: var(--akzent); color: var(--text); }
  .hero .btn.sekundaer { background: transparent; color: #fff; border-color: #fff; }
  .hinweis { background: var(--akzent); color: var(--text); padding-block: 0.9rem; font-weight: 600; text-align: center; }
  .karte { background: #fff; }
  .gruppe + .gruppe { margin-top: 2rem; }
  .gruppe h3 { color: var(--primaer); border-bottom: 2px solid var(--akzent); padding-bottom: 0.3rem; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { padding-block: 0.7rem; border-bottom: 1px dashed color-mix(in srgb, var(--text) 20%, transparent); }
  .zeile { display: flex; justify-content: space-between; gap: 1rem; font-weight: 600; }
  .preis { white-space: nowrap; }
  .vegi { color: #3d7a3a; font-weight: 400; font-size: 0.9rem; }
  .beschr { margin: 0.2rem 0 0; font-size: 0.95rem; opacity: 0.8; }
  dl { margin: 0; }
  .tag { display: flex; justify-content: space-between; gap: 1rem; padding-block: 0.5rem; border-bottom: 1px solid color-mix(in srgb, var(--text) 12%, transparent); }
  dt { font-weight: 600; }
  dd { margin: 0; text-align: right; }
  .block { display: block; white-space: nowrap; }
  address { font-style: normal; margin-bottom: 1rem; }
</style>
