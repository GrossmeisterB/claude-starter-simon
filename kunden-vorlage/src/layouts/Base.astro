---
import site from "../content/site.json";
import { indexable } from "../lib/indexable.mjs";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.beschreibung } = Astro.props;
const pageTitle = title ? `${title} – ${site.name}` : `${site.name} – ${site.art} in ${site.kontakt.ort}`;
const k = site.kontakt;

const schema = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  name: site.name,
  description: site.beschreibung,
  servesCuisine: site.kueche,
  telephone: k.telefon,
  email: k.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: k.strasse,
    postalCode: k.plz,
    addressLocality: k.ort,
    addressCountry: "CH",
  },
  openingHoursSpecification: site.oeffnungszeiten.flatMap((o) =>
    (o.schema ?? []).map((s) => ({
      "@type": "OpeningHoursSpecification",
      dayOfWeek: s.tage.map((t) => `https://schema.org/${{ Mo: "Monday", Tu: "Tuesday", We: "Wednesday", Th: "Thursday", Fr: "Friday", Sa: "Saturday", Su: "Sunday" }[t]}`),
      opens: s.von,
      closes: s.bis,
    })),
  ),
  ...(site.domain ? { url: `https://${site.domain}` } : {}),
};
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <style is:global>
      /* Bewusst roher Platzhalter: kunden-design ersetzt die Gestaltung pro Kunde komplett. */
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body { margin: 0; font-family: system-ui, sans-serif; line-height: 1.5; color: #000; background: #fff; }
      img { max-width: 100%; height: auto; }
      .wrap { width: min(100% - 2rem, 60rem); margin-inline: auto; }
    </style>
  </head>
  <body>
    <header class="kopf">
      <div class="wrap kopf-inner">
        <a href="/" class="logo">{site.name}</a>
        <nav aria-label="Hauptnavigation">
          <a href="/#speisekarte">Speisekarte</a>
          <a href="/#zeiten">Öffnungszeiten</a>
          <a href="/#kontakt">Kontakt</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="fuss">
      <div class="wrap">
        <p><strong>{site.name}</strong> · {k.strasse} · {k.plz} {k.ort} · <a href={`tel:${k.telefon.replace(/\s/g, "")}`}>{k.telefon}</a></p>
        <p><a href="/impressum">Impressum</a> · <a href="/datenschutz">Datenschutz</a></p>
      </div>
    </footer>
  </body>
</html>
