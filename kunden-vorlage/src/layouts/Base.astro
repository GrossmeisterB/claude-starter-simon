---
import site from "../content/site.json";
import { indexable } from "../lib/indexable.mjs";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.beschreibung } = Astro.props;
const pageTitle = title ? `${title} – ${site.name}` : `${site.name} – ${site.art} in ${site.kontakt.ort}`;
const k = site.kontakt;

const schema = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  name: site.name,
  description: site.beschreibung,
  servesCuisine: site.kueche,
  telephone: k.telefon,
  email: k.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: k.strasse,
    postalCode: k.plz,
    addressLocality: k.ort,
    addressCountry: "CH",
  },
  openingHoursSpecification: site.oeffnungszeiten.flatMap((o) =>
    (o.schema ?? []).map((s) => ({
      "@type": "OpeningHoursSpecification",
      dayOfWeek: s.tage.map((t) => `https://schema.org/${{ Mo: "Monday", Tu: "Tuesday", We: "Wednesday", Th: "Thursday", Fr: "Friday", Sa: "Saturday", Su: "Sunday" }[t]}`),
      opens: s.von,
      closes: s.bis,
    })),
  ),
  ...(site.domain ? { url: `https://${site.domain}` } : {}),
};
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={site.farben.primaer} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <style
      is:global
      define:vars={{
        primaer: site.farben.primaer,
        akzent: site.farben.akzent,
        hintergrund: site.farben.hintergrund,
        text: site.farben.text,
      }}
    >
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        font-size: 1.0625rem;
        line-height: 1.6;
        color: var(--text);
        background: var(--hintergrund);
      }
      h1, h2, h3 { font-family: Georgia, "Times New Roman", serif; line-height: 1.2; margin: 0 0 0.5em; }
      a { color: var(--primaer); }
      img { max-width: 100%; height: auto; }
      .wrap { width: min(100% - 2rem, 60rem); margin-inline: auto; }
      section { padding-block: 3rem; }
      .btn {
        display: inline-block;
        padding: 0.8rem 1.4rem;
        border-radius: 999px;
        background: var(--primaer);
        color: #fff;
        text-decoration: none;
        font-weight: 600;
        min-height: 44px;
      }
      .btn.sekundaer { background: transparent; color: var(--primaer); border: 2px solid var(--primaer); }
    </style>
  </head>
  <body>
    <header class="kopf">
      <div class="wrap kopf-inner">
        <a href="/" class="logo">{site.name}</a>
        <nav aria-label="Hauptnavigation">
          <a href="/#speisekarte">Speisekarte</a>
          <a href="/#zeiten">Öffnungszeiten</a>
          <a href="/#kontakt">Kontakt</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="fuss">
      <div class="wrap">
        <p><strong>{site.name}</strong> · {k.strasse} · {k.plz} {k.ort} · <a href={`tel:${k.telefon.replace(/\s/g, "")}`}>{k.telefon}</a></p>
        <p><a href="/impressum">Impressum</a> · <a href="/datenschutz">Datenschutz</a></p>
      </div>
    </footer>
  </body>
</html>

<style>
  .kopf { background: var(--primaer); color: #fff; position: sticky; top: 0; z-index: 10; }
  .kopf-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1.5rem; padding-block: 0.75rem; }
  .logo { color: #fff; text-decoration: none; font-family: Georgia, serif; font-size: 1.25rem; font-weight: 700; }
  nav { display: flex; gap: 1rem; flex-wrap: wrap; }
  nav a { color: #fff; text-decoration: none; font-size: 0.95rem; padding-block: 0.4rem; }
  .fuss { background: var(--text); color: var(--hintergrund); padding-block: 2rem; font-size: 0.95rem; }
  .fuss a { color: var(--akzent); }
</style>
